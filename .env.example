# Canton CBTC Library Configuration Example
# Copy this file to .env and fill in your values

# The real host values for each environment live in 1Password, not here. This
# file lists every variable and a placeholder, so you can see what to set.
#
# Two traps to know about before running anything:
#
# 1. `dotenvy::dotenv()` does not override a variable your shell already
#    exported. A shell that exported working hosts therefore arms every live
#    test, and several of them write to shared devnet wallets. Run build, lint
#    and test gates in a shell that has NOT sourced this file. Check with:
#      env | grep -E 'KEYCLOAK|LEDGER_HOST'   # must print nothing
# 2. Only one participant node answers a password-grant token per environment.
#    Probe `/v2/state/ledger-end` before assuming; the others answer 401.

# =============================================================================
# CORE CONFIGURATION (Required for all operations)
# =============================================================================

# CANTON LEDGER
# Your Canton participant node's JSON ledger API host, including the API path
LEDGER_HOST=https://participant.example.com/api/json-api
# Your party ID on the Canton network
PARTY_ID=your-party::1220abcdef...

# KEYCLOAK (authentication for every operation)
# Host only. Do not append `/auth`: no deployed Keycloak serves that prefix.
KEYCLOAK_HOST=https://keycloak.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_USERNAME=your-username
KEYCLOAK_PASSWORD=your-password

# =============================================================================
# MINT & REDEEM OPERATIONS (Required for BTC ↔ CBTC bridging)
# =============================================================================

# BITSAFE API
# Unified Bitsafe API URL for BTC/CBTC bridging operations (network-specific)
# Devnet: https://api.devnet.bitsafe.finance
# Testnet: https://api.testnet.bitsafe.finance
# Mainnet: https://api.mainnet.bitsafe.finance
BITSAFE_API_URL=https://api.devnet.bitsafe.finance

# Destination Bitcoin address for withdrawals (for testing withdraw account creation)
# This should be a valid Bitcoin address for your target network
# Devnet/Regtest: bcrt1q... (regtest bech32)
# Testnet: tb1q... (testnet bech32)
# Mainnet: bc1q... (mainnet bech32)
DESTINATION_BTC_ADDRESS=

# =============================================================================
# SEND & TRANSFER OPERATIONS (Required for sending CBTC to other parties)
# =============================================================================

# CBTC NETWORK CONFIGURATION
# The decentralized party ID for CBTC (environment-specific)
# Devnet: cbtc-network::12202a83c6f4082217c175e29bc53da5f2703ba2675778ab99217a5a881a949203ff
# Testnet: cbtc-network::12201b1741b63e2494e4214cf0bedc3d5a224da53b3bf4d76dba468f8e97eb15508f
# Mainnet: cbtc-network::12205af3b949a04776fc48cdcc05a060f6bda2e470632935f375d1049a8546a3b262
DECENTRALIZED_PARTY_ID=cbtc-network::12202a83c6f4082217c175e29bc53da5f2703ba2675778ab99217a5a881a949203ff

# Registry URL (environment-specific)
# Devnet: https://api.utilities.digitalasset-dev.com
# Testnet: https://api.utilities.digitalasset-staging.com
# Mainnet: https://api.utilities.digitalasset.com
REGISTRY_URL=https://api.utilities.digitalasset-dev.com

# Optional: Transfer amount for send examples (default: 0.1)
TRANSFER_AMOUNT=0.1

# Optional: CSV file path for batch distribution (default: recipients.csv)
RECIPIENTS_CSV=recipients.csv

# =============================================================================
# STREAM EXAMPLE (for stream_cbtc example)
# =============================================================================
# RECEIVER_PARTY=receiver-party::1220...
# TRANSFER_COUNT=10

# =============================================================================
# TESTING (for running integration tests)
# =============================================================================
# Test receiver party ID (for transfer tests)
LIB_TEST_RECEIVER_PARTY_ID=example-receiver::1220...

# Transfer offer contract ID (for accept transfer test - optional, test will skip if not set)
LIB_TEST_TRANSFER_OFFER_CID=

# Client secret for ledger end tests (client credentials flow)
LIB_TEST_LEDGER_END_CLIENT_SECRET=your-client-secret-here

# Client secret for amulet rules tests (client credentials flow)
LIB_TEST_AMULET_CLIENT_SECRET=your-amulet-client-secret-here

# Wallet API host for amulet rules tests
WALLET_API_HOST=https://wallet.example.com

RUST_LOG=trace,tungstenite=error,tokio_tungstenite=error,reqwest=error


# =============================================================================
# INTEGRATION TEST (cargo run --example integration_test)
# =============================================================================
# This example writes to the ledger. On devnet it uses two shared wallets, so
# never run two at once.

# Which Token Standard API the run exercises: V1 or V2. Defaults to V1.
TOKEN_STANDARD_VERSION=V1

# Amount to burn in the withdrawal step. Defaults to TRANSFER_AMOUNT.
WITHDRAW_AMOUNT=0.1

# UTXO count at or above which the consolidation step consolidates.
# Defaults to 10. The step writes at the threshold, not only above it.
CONSOLIDATION_THRESHOLD=10

# Set to 1 to accept a free credential offer during the run. Skipped otherwise.
RUN_CREDENTIAL_ACCEPT=

# Optional faucet. When set, the run adds three steps and renumbers the rest.
# An empty value counts as unset, so the faucet steps stay off.
#FAUCET_URL=
FAUCET_NETWORK=devnet

# The receiver party. A participant authorises a token for one party, so the
# receiver needs its own credentials rather than sharing the sender's.
# These are REQUIRED:
RECEIVER_KEYCLOAK_CLIENT_ID=
RECEIVER_KEYCLOAK_USERNAME=
RECEIVER_KEYCLOAK_PASSWORD=
RECEIVER_PARTY_ID=
# These are optional. Each falls back to its sender twin when you leave it
# unset, and also when you set it to "". The example reads an empty value as no
# value, because a copied template assigns rather than unsets.
#RECEIVER_LEDGER_HOST=
#RECEIVER_KEYCLOAK_HOST=
#RECEIVER_KEYCLOAK_REALM=
